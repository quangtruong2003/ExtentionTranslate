{
  "manifest_version": 3,
  "name": "ExtentionTranslate",
  "version": "1.2.0",
  "description": "Instant English dictionary popup with English, Vietnamese, and Simplified Chinese display plus streaming OpenRouter AI.",
  "minimum_chrome_version": "114",
  "permissions": ["storage"],
  "host_permissions": ["https://api.dictionaryapi.dev/*", "https://freedictionaryapi.com/*", "https://openrouter.ai/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ExtentionTranslate — Mở cài đặt"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
